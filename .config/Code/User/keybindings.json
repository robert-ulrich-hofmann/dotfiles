    // poor man's modal overlay (works in single and split view)
    {
        "key": "ctrl+alt+m",
        "command": "runCommands",
        "args": {
            "commands": [
                "workbench.action.toggleEditorWidths",
                "workbench.action.toggleCenteredLayout"
            ]
        },
        "when": "editorTextFocus"
    }
]
